# ── local-only working files ─────────────────────────────────────
# Drop zone for wallpapers you are about to ingest. The ingest script
# consumes these and writes the processed copy into wallpapers/, so the
# originals never belong in the repo.
incoming/*
!incoming/.gitkeep

# Same idea — any local staging folder for pre-processing (e.g. upscale_batch.py
# source material) before it lands in incoming/
old/

# Local reference material for the DM-submission workflow — never published,
# stays on this machine only.
sample-submission/

# Working artifacts from a cull or audit run. cull.py writes the .bak before
# it mutates anything and audit.py writes the flagged-id list; both are for
# the operator running the command, not for the repo.
*.bak
flagged.txt
rejects.txt

# Local session/tooling state
.remember/
.claude/
.impeccable/
*.local
*.log
NOTES.local.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Downloaded on first run by upscale_batch.py — not source, don't commit
scripts/.cache/

# Installed during the Cloudflare build; never belongs in the repo
node_modules/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Secrets — Reddit credentials live in GitHub Actions secrets, never here
.env
.env.*
!.env.example
