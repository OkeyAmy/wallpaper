# Assets dir is the repo root, so anything not part of the served site has to
# be excluded here. node_modules is the blocking one: wrangler's own workerd
# binary is 97 MiB and Workers rejects any asset over 25 MiB.
node_modules
# Never upload local credentials or notes, even on a manual `wrangler deploy`
# (the git-based deploy would not have them, but this makes it unconditional).
.env
.env.*
NOTES.local.md
*.bak
scripts
old
incoming
.git
.github
.remember
.claude
.impeccable
worker.js
wrangler.toml
package.json
package-lock.json
.assetsignore
.gitignore
README.md
index
data/removed.json
data/anime_series.json
